# Configuracion del servidor portatil
# Edita estos valores y guarda.

WORLD_NAME="mundo"     # nombre del mundo (archivo worlds/<nombre>.wld)
PORT="7777"            # puerto del servidor
PLAYERS="8"            # jugadores maximos
PASSWORD=""            # contraseña (vacio = sin contraseña)
AUTOCREATE="1"         # tamaño si hay que crear el mundo: 1 pequeño, 2 mediano, 3 grande
EVIL=""                # vacio = aleatorio (para elegir maldad usa la consola o terra)
